# Calla Platform Environment Variables

# Required: Gemini API Key
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Twilio Credentials (for voice calls to patients)
# Get your credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Optional: JWT Secret (default will be used if not set)
JWT_SECRET=your-secret-key-change-in-production

# Optional: Firebase Credentials Path (no longer required for voice-only system)
FIREBASE_CREDENTIALS_PATH=backend/firebase-service-account.json
